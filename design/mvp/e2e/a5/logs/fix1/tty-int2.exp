set timeout 30
set R [lindex $argv 0]
set v [lindex $argv 1]
spawn sh -c "env -i PATH=$R/prefix/bin:$R/bin:/usr/bin:/bin HOME=$R/user HARNESS_HOME=$R/home $R/prefix/bin/node /tmp/swarm-a5fix/$v/harness/src/cli.ts setup; echo node-exit=\$?; stty -a | tr ' ' '\\n' | grep -x -e echo -e -echo"
expect "non viene mostrato): " ; send "\003"
expect eof
